{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Cam",
  "version": "0.1.2",
  "identifier": "dev.bettercam.app",
  "build": {
    "beforeDevCommand": "npm run vcam:build && npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run vcam:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Better Cam",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "NoxLoveYa",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../target/vcam-stage/better_cam_vcam.dll": "vcam/better_cam_vcam.dll" },
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": { "installMode": "perMachine", "installerHooks": "./windows/hooks.nsh" }
    }
  }
}
