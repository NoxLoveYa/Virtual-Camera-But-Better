{
    "steps":  [
                  {
                      "text":  "== 1080p60 synthetic, four filters, consumer that negotiated 30 fps",
                      "do":  "print"
                  },
                  {
                      "do":  "start",
                      "source":  {
                                     "video_device_id":  null,
                                     "res_type":  "custom",
                                     "resolution":  "1920x1080",
                                     "frame_interval":  166667,
                                     "video_format":  "nv12",
                                     "color_space":  "default",
                                     "color_range":  "default",
                                     "buffering":  "auto",
