                                                   },
                                        "enabled":  true,
                                        "id":  "lu",
                                        "kind":  "clut_filter"
                                    },
                                    {
                                        "params":  {
                                                       "resolution":  "1280x720",
                                                       "sampling":  "bicubic"
                                                   },
                                        "enabled":  true,
                                        "id":  "sc",
                                        "kind":  "scale_filter"
                                    }
                                ],
                      "synthetic":  {
                                        "width":  1920,
                                        "height":  1080,
                                        "fps":  60
                                    }
