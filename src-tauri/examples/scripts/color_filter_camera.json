{
  "steps": [
    { "do": "print", "text": "== Color Correction on the physical camera (the first listed): set_chain saturation -1 turns the pictures the virtual camera delivers gray" },
    { "do": "list_cameras" },
    { "do": "start",
      "source": {
        "video_device_id": null, "res_type": "custom", "resolution": "1280x720", "frame_interval": 333333,
        "video_format": "mjpeg", "color_space": "default", "color_range": "default", "buffering": "auto",
        "flip_vertically": false, "autorotation": true, "hw_decode": true, "deactivate_when_not_showing": false
      },
      "output": { "resolution": "1280x720", "fps": "source", "fit": "fit", "background_color": 4278190080, "extra_sizes": true },
      "chain": [] },
    { "do": "wait_state", "state": "live", "timeout": 20, "label": "start -> live" },
    { "do": "consume", "seconds": 9, "size": "1280x720", "label": "consumer on the camera", "fps": 30, "dump": "camera_color.png", "gain": 1, "background": true },
    { "do": "sleep", "seconds": 4 },
    { "do": "set_chain", "mark": "gray", "label": "set_chain saturation -1 -> picture gray",
      "chain": [ { "id": "cc1", "kind": "color_filter", "enabled": true, "params": { "saturation": -1 } } ] },
    { "do": "sleep", "seconds": 3 },
    { "do": "join" },
    { "do": "stop" },
    { "do": "wait_state", "state": "stopped", "timeout": 5, "label": "stop -> stopped" }
  ]
}
