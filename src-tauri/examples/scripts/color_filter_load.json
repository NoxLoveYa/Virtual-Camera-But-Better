{
  "steps": [
    { "do": "print", "text": "== Live updates under load: 1080p60 synthetic bars, 60 set_chain calls a second for 5 s sweeping saturation; GPU time and gaps with and without the filter" },
    { "do": "start",
      "source": {
        "video_device_id": null, "res_type": "custom", "resolution": "1920x1080", "frame_interval": 166666,
        "video_format": "nv12", "color_space": "default", "color_range": "default", "buffering": "auto",
        "flip_vertically": false, "autorotation": true, "hw_decode": true, "deactivate_when_not_showing": false
      },
      "output": { "resolution": "1920x1080", "fps": "source", "fit": "fit", "background_color": 4278190080, "extra_sizes": true },
      "synthetic": { "width": 1920, "height": 1080, "fps": 60 },
      "chain": [] },
    { "do": "wait_state", "state": "live", "timeout": 15, "label": "start -> live" },
    { "do": "consume", "seconds": 17, "size": "1920x1080", "label": "consumer 1080p60 over all phases", "light": true, "fps": 60, "background": true },

    { "do": "sleep", "seconds": 4 },
    { "do": "stats_report", "label": "without the filter (3 s)", "seconds": 3 },

    { "do": "set_chain", "label": "filter on", "chain": [ { "id": "cc1", "kind": "color_filter", "enabled": true, "params": { "saturation": 1 } } ] },
    { "do": "sleep", "seconds": 4 },
    { "do": "stats_report", "label": "filter on, no updates (3 s)", "seconds": 3 },

    { "do": "sweep_chain", "id": "cc1", "kind": "color_filter", "param": "saturation", "from": -1, "to": 5, "hz": 60, "seconds": 5 },
    { "do": "stats_report", "label": "during the 60 Hz sweep (5 s)", "seconds": 5 },

    { "do": "set_chain", "label": "filter off", "chain": [] },
    { "do": "sleep", "seconds": 3 },
    { "do": "stats_report", "label": "without the filter again (2 s)", "seconds": 2 },
    { "do": "join" },
    { "do": "stop" },
    { "do": "wait_state", "state": "stopped", "timeout": 5, "label": "stop -> stopped" }
  ]
}
