{
  "name": "better-cam",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:schema": "esbuild src/camera/schema.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/schema-test.mjs && node node_modules/.cache/schema-test.mjs",
    "test:ui": "esbuild src/ui/chainDrag.test.ts src/ui/fileDrop.test.ts src/ui/layout.test.ts src/ui/insertDrag.test.ts --bundle --platform=node --format=esm --log-level=warning --outdir=node_modules/.cache/ui-test --out-extension:.js=.mjs && node node_modules/.cache/ui-test/chainDrag.test.mjs && node node_modules/.cache/ui-test/fileDrop.test.mjs && node node_modules/.cache/ui-test/layout.test.mjs && node node_modules/.cache/ui-test/insertDrag.test.mjs",
    "test:ext": "esbuild src/filters/ext.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/ext-test.mjs && node node_modules/.cache/ext-test.mjs",
    "tauri": "tauri",
    "schema:export": "node scripts/export-schema.mjs",
    "vcam:build": "cargo build -p vcam-source --release",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7"
  }
}
